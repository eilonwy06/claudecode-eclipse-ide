<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>

   <!-- Claude IDE Server View -->
   <extension point="org.eclipse.ui.views">
      <category
            id="com.anthropic.claudecode.eclipse.category"
            name="Claude Code"/>
      <view
            id="com.anthropic.claudecode.eclipse.ui.ClaudeCodeView"
            name="Claude IDE Server"
            icon="icons/claude-16.png"
            class="com.anthropic.claudecode.eclipse.ui.ClaudeCodeView"
            category="com.anthropic.claudecode.eclipse.category"
            allowMultiple="false"
            restorable="true"/>
      <!-- Claude Chat view DISABLED: superseded by the Claude Code (GUI) view.
           Unregistered so it can't be opened / doesn't appear in Show View.
           Code is kept (ClaudeChatView.java). -->
      <!--
      <view
            id="com.anthropic.claudecode.eclipse.ui.ClaudeChatView"
            name="Claude Chat"
            icon="icons/claude-16.png"
            class="com.anthropic.claudecode.eclipse.ui.ClaudeChatView"
            category="com.anthropic.claudecode.eclipse.category"
            allowMultiple="false"
            restorable="true"/>
      -->
      <view
            id="com.anthropic.claudecode.eclipse.ui.ClaudeCliView"
            name="Claude Terminal"
            icon="icons/claude-16.png"
            class="com.anthropic.claudecode.eclipse.ui.ClaudeCliView"
            category="com.anthropic.claudecode.eclipse.category"
            allowMultiple="false"
            restorable="true"/>
      <view
            id="com.anthropic.claudecode.eclipse.ui.ClaudeGuiView"
            name="Claude Code"
            icon="icons/claude-16.png"
            class="com.anthropic.claudecode.eclipse.ui.ClaudeGuiView"
            category="com.anthropic.claudecode.eclipse.category"
            allowMultiple="false"
            restorable="true"/>
   </extension>

   <!-- Commands -->
   <extension point="org.eclipse.ui.commands">
      <category
            id="com.anthropic.claudecode.eclipse.commands.category"
            name="Claude Code"/>
      <command
            id="com.anthropic.claudecode.eclipse.commands.toggle"
            name="Activate Claude IDE Server"
            description="Show the Claude IDE Server view"
            categoryId="com.anthropic.claudecode.eclipse.commands.category"/>
      <command
            id="com.anthropic.claudecode.eclipse.commands.toggleGui"
            name="Activate Claude Code"
            description="Show the Claude Code view"
            categoryId="com.anthropic.claudecode.eclipse.commands.category"/>
      <command
            id="com.anthropic.claudecode.eclipse.commands.sendSelection"
            name="Send Selection to Claude Terminal"
            description="Send the current editor selection to the Claude Terminal"
            categoryId="com.anthropic.claudecode.eclipse.commands.category"/>
      <command
            id="com.anthropic.claudecode.eclipse.commands.addFile"
            name="Add File to Claude Terminal"
            description="Add the current file to the Claude Terminal's context"
            categoryId="com.anthropic.claudecode.eclipse.commands.category"/>
      <command
            id="com.anthropic.claudecode.eclipse.commands.restart"
            name="Restart Claude Code Server"
            description="Restart the MCP server"
            categoryId="com.anthropic.claudecode.eclipse.commands.category"/>
      <command
            id="com.anthropic.claudecode.eclipse.commands.activateCli"
            name="Activate Claude Terminal"
            description="Open the Claude Terminal view"
            categoryId="com.anthropic.claudecode.eclipse.commands.category"/>
      <command
            id="com.anthropic.claudecode.eclipse.commands.dismissCard"
            name="Dismiss Claude Card"
            description="Dismiss the permission, question or diff-review card awaiting an answer"
            categoryId="com.anthropic.claudecode.eclipse.commands.category"/>
   </extension>

   <!-- Active only while a card is awaiting an answer, so the binding below cannot
        shadow Esc (or anything else) for the rest of the IDE. Activated and
        deactivated by ClaudeGuiView.cardOpened/cardClosed. -->
   <extension point="org.eclipse.ui.contexts">
      <context
            id="com.anthropic.claudecode.eclipse.contexts.cardOpen"
            name="Claude Card Open"
            description="A Claude permission, question or diff-review card is awaiting an answer"
            parentId="org.eclipse.ui.contexts.window"/>
   </extension>

   <!-- Command Handlers -->
   <extension point="org.eclipse.ui.handlers">
      <handler
            commandId="com.anthropic.claudecode.eclipse.commands.toggle"
            class="com.anthropic.claudecode.eclipse.ui.handlers.ActivateClaudeServerHandler"/>
      <handler
            commandId="com.anthropic.claudecode.eclipse.commands.toggleGui"
            class="com.anthropic.claudecode.eclipse.ui.handlers.ActivateClaudeGuiHandler"/>
      <handler
            commandId="com.anthropic.claudecode.eclipse.commands.sendSelection"
            class="com.anthropic.claudecode.eclipse.ui.handlers.SendSelectionHandler"/>
      <handler
            commandId="com.anthropic.claudecode.eclipse.commands.addFile"
            class="com.anthropic.claudecode.eclipse.ui.handlers.AddFileHandler"/>
      <handler
            commandId="com.anthropic.claudecode.eclipse.commands.restart"
            class="com.anthropic.claudecode.eclipse.ui.handlers.RestartServerHandler"/>
      <handler
            commandId="com.anthropic.claudecode.eclipse.commands.activateCli"
            class="com.anthropic.claudecode.eclipse.ui.handlers.ActivateClaudeCliHandler"/>
      <handler
            commandId="com.anthropic.claudecode.eclipse.commands.dismissCard"
            class="com.anthropic.claudecode.eclipse.ui.handlers.DismissCardHandler"/>
   </extension>

   <!-- Key Bindings -->
   <extension point="org.eclipse.ui.bindings">
      <key
            commandId="com.anthropic.claudecode.eclipse.commands.toggle"
            schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"
            sequence="M1+M2+C"/>
      <key
            commandId="com.anthropic.claudecode.eclipse.commands.sendSelection"
            schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"
            sequence="M1+M3+S"/>
      <key
            commandId="com.anthropic.claudecode.eclipse.commands.addFile"
            schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"
            sequence="M1+M3+A"/>
      <key
            commandId="com.anthropic.claudecode.eclipse.commands.activateCli"
            schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"
            sequence="M1+`"/>
      <!-- Per scheme, because the Emacs scheme claims ESC as a multi-stroke PREFIX
           (ESC V, ESC F, ESC D, …): Eclipse holds the keystroke waiting for a second
           one, so it never reaches the card. CTRL+G is Emacs's own keyboard-quit, and
           the only thing binding it there is clear.mark under textEditorScope, which
           is not active in a view. Both are scoped to the card context, so the card
           advertises whichever binding is actually live — see
           ClaudeGuiView.cancelKeyLabel(). -->
      <key
            commandId="com.anthropic.claudecode.eclipse.commands.dismissCard"
            schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"
            contextId="com.anthropic.claudecode.eclipse.contexts.cardOpen"
            sequence="ESC"/>
      <key
            commandId="com.anthropic.claudecode.eclipse.commands.dismissCard"
            schemeId="org.eclipse.ui.emacsAcceleratorConfiguration"
            contextId="com.anthropic.claudecode.eclipse.contexts.cardOpen"
            sequence="CTRL+G"/>
   </extension>

   <!-- Menus and Toolbar -->
   <extension point="org.eclipse.ui.menus">
      <!-- Main menu contribution -->
      <menuContribution locationURI="menu:org.eclipse.ui.main.menu?after=additions">
         <menu
               id="com.anthropic.claudecode.eclipse.menu"
               label="Claude Code"
               mnemonic="C">
            <command
                  commandId="com.anthropic.claudecode.eclipse.commands.toggleGui"
                  label="Activate Claude Code"
                  mnemonic="C"
                  style="push"/>
            <command
                  commandId="com.anthropic.claudecode.eclipse.commands.activateCli"
                  label="Activate Claude Terminal"
                  mnemonic="L"
                  style="push"/>
            <!-- Debug-only: visible only while debug mode is on (see debugMode source variable). -->
            <command
                  commandId="com.anthropic.claudecode.eclipse.commands.toggle"
                  label="Activate Claude IDE Server"
                  mnemonic="I"
                  style="push">
               <visibleWhen checkEnabled="false">
                  <with variable="com.anthropic.claudecode.eclipse.debugMode">
                     <equals value="true"/>
                  </with>
               </visibleWhen>
            </command>
            <separator name="com.anthropic.claudecode.eclipse.separator1" visible="true"/>
            <command
                  commandId="com.anthropic.claudecode.eclipse.commands.sendSelection"
                  label="Send Selection to Claude Terminal"
                  mnemonic="S"
                  style="push"/>
            <command
                  commandId="com.anthropic.claudecode.eclipse.commands.addFile"
                  label="Add File to Claude Terminal"
                  mnemonic="A"
                  style="push"/>
         </menu>
      </menuContribution>

      <!-- Editor context menu -->
      <menuContribution locationURI="popup:#TextEditorContext?after=additions">
         <menu
               id="com.anthropic.claudecode.eclipse.editorMenu"
               label="Claude Code">
            <command
                  commandId="com.anthropic.claudecode.eclipse.commands.sendSelection"
                  label="Send Selection to Claude Terminal"
                  style="push"/>
            <command
                  commandId="com.anthropic.claudecode.eclipse.commands.addFile"
                  label="Add File to Claude Terminal"
                  style="push"/>
         </menu>
      </menuContribution>

      <!-- Toolbar -->
      <menuContribution locationURI="toolbar:org.eclipse.ui.main.toolbar?after=additions">
         <toolbar id="com.anthropic.claudecode.eclipse.toolbar">
            <command
                  commandId="com.anthropic.claudecode.eclipse.commands.activateCli"
                  icon="icons/claude-16.png"
                  label="Activate Claude Terminal"
                  style="push"
                  tooltip="Activate Claude Terminal"/>
         </toolbar>
      </menuContribution>
   </extension>

   <!-- Debug-only UI gating.
        The debug activity filters the "Claude IDE Server" view (and its Activate
        command) out of Show View / key bindings. Its enablement is driven purely
        by the debugMode source variable (published by DebugModeSourceProvider),
        so it turns on/off with the Debug mode preference with no default-state
        guesswork and no reliance on runtime activity toggling. -->
   <extension point="org.eclipse.ui.activities">
      <activity
            id="com.anthropic.claudecode.eclipse.activity.debug"
            name="Claude Code Debug Tools"
            description="Debug-only Claude Code UI, such as the Claude IDE Server view.">
         <enabledWhen>
            <with variable="com.anthropic.claudecode.eclipse.debugMode">
               <equals value="true"/>
            </with>
         </enabledWhen>
      </activity>
      <activityPatternBinding
            activityId="com.anthropic.claudecode.eclipse.activity.debug"
            isEqualityPattern="true"
            pattern="com.anthropic.claudecode.eclipse/com.anthropic.claudecode.eclipse.ui.ClaudeCodeView"/>
      <activityPatternBinding
            activityId="com.anthropic.claudecode.eclipse.activity.debug"
            isEqualityPattern="true"
            pattern="com.anthropic.claudecode.eclipse/com.anthropic.claudecode.eclipse.commands.toggle"/>
   </extension>

   <!-- Publishes the debugMode source variable used by menu visibleWhen expressions. -->
   <extension point="org.eclipse.ui.services">
      <sourceProvider
            provider="com.anthropic.claudecode.eclipse.ui.DebugModeSourceProvider">
         <variable
               name="com.anthropic.claudecode.eclipse.debugMode"
               priorityLevel="workbench"/>
      </sourceProvider>
   </extension>

