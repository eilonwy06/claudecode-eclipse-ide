   <!-- "Open Claude Here" - context menu for navigators. One top-level entry that
        opens a submenu with both targets, so the GUI and the terminal each get a
        first-class item without two separate entries in every navigator's menu.

        org.eclipse.ui.menus rather than the older popupMenus/objectContribution: only
        this extension point lets the SUBMENU itself carry an icon (a <menu> under
        popupMenus has no icon attribute - none of Eclipse's own popupMenus
        contributions declares one). The commands deliberately carry NO icon, so the
        Claude mark appears once, on the parent. -->
   <extension point="org.eclipse.ui.commands">
      <command
            id="com.anthropic.claudecode.eclipse.commands.openCodeHere"
            name="Open Claude Code Here"
            categoryId="com.anthropic.claudecode.eclipse.commands.category"/>
      <command
            id="com.anthropic.claudecode.eclipse.commands.openTerminalHere"
            name="Open Claude Terminal Here"
            categoryId="com.anthropic.claudecode.eclipse.commands.category"/>
   </extension>

   <extension point="org.eclipse.ui.handlers">
      <handler
            commandId="com.anthropic.claudecode.eclipse.commands.openCodeHere"
            class="com.anthropic.claudecode.eclipse.ui.handlers.OpenCodeHereHandler"/>
      <handler
            commandId="com.anthropic.claudecode.eclipse.commands.openTerminalHere"
            class="com.anthropic.claudecode.eclipse.ui.handlers.OpenTerminalHereHandler"/>
   </extension>

   <extension point="org.eclipse.ui.menus">
      <menuContribution locationURI="popup:org.eclipse.ui.popup.any?after=additions">
         <menu
               id="com.anthropic.claudecode.eclipse.menus.openClaudeHere"
               label="Open Claude Here"
               icon="icons/claude-16.png">
            <command
                  commandId="com.anthropic.claudecode.eclipse.commands.openCodeHere"
                  id="com.anthropic.claudecode.eclipse.menus.openCodeHere"
                  label="Claude Code"
                  style="push"/>
            <command
                  commandId="com.anthropic.claudecode.eclipse.commands.openTerminalHere"
                  id="com.anthropic.claudecode.eclipse.menus.openTerminalHere"
                  label="Claude Terminal"
                  style="push"/>
            <!-- adapt, not instanceof: the Package Explorer hands over Java-model
                 nodes (IJavaProject, IPackageFragment), not IResource. This is the
                 equivalent of the old contribution's adaptable="true", and casting
                 instead would silently drop the menu on exactly those nodes. -->
            <visibleWhen checkEnabled="false">
               <with variable="selection">
                  <iterate ifEmpty="false" operator="and">
                     <adapt type="org.eclipse.core.resources.IResource"/>
                  </iterate>
               </with>
            </visibleWhen>
         </menu>
      </menuContribution>
   </extension>

</plugin>
