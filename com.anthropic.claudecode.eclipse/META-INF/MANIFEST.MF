Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: Claude Code for Eclipse
Bundle-SymbolicName: com.anthropic.claudecode.eclipse;singleton:=true
Bundle-Version: 2.4.6.qualifier
Bundle-Activator: com.anthropic.claudecode.eclipse.Activator
Bundle-Vendor: eilonwy06
Require-Bundle: org.eclipse.ui,
 org.eclipse.core.runtime,
 org.eclipse.core.resources,
 org.eclipse.core.filesystem,
 org.eclipse.ui.editors,
 org.eclipse.ui.ide,
 org.eclipse.ui.console,
 org.eclipse.ui.workbench.texteditor,
 org.eclipse.jface.text,
 org.eclipse.compare,
 org.eclipse.debug.ui,
 org.eclipse.debug.core,
 org.eclipse.jdt.core;bundle-version="[3.0.0,4.0.0)";resolution:=optional,
 org.eclipse.jdt.ui;bundle-version="[3.0.0,4.0.0)";resolution:=optional,
 org.eclipse.jdt.launching;resolution:=optional,
 org.eclipse.jdt.junit;resolution:=optional,
 org.eclipse.jdt.junit.core;resolution:=optional,
 org.python.pydev.core;resolution:=optional,
 org.python.pydev.ast;resolution:=optional,
 org.python.pydev;resolution:=optional,
 com.python.pydev.analysis;resolution:=optional,
 org.eclipse.terminal.control;bundle-version="[1.1.0,2.0.0)",
 org.eclipse.terminal.connector.process;bundle-version="[1.1.0,2.0.0)",
 org.eclipse.terminal.connector.local;bundle-version="[1.1.0,2.0.0)",
 com.google.gson
Bundle-ClassPath: .
Bundle-NativeCode: native/windows/x86_64/claude_eclipse_core.dll;\
  osname=Win32;processor=x86-64,\
  native/linux/x86_64/libclaude_eclipse_core.so;\
  osname=Linux;processor=x86-64,\
  native/macos/x86_64/libclaude_eclipse_core.dylib;\
  osname=MacOS X;processor=x86-64,\
  native/macos/aarch64/libclaude_eclipse_core.dylib;\
  osname=MacOS X;processor=aarch64
Bundle-RequiredExecutionEnvironment: JavaSE-21
Automatic-Module-Name: com.anthropic.claudecode.eclipse
Bundle-ActivationPolicy: lazy
Export-Package: com.anthropic.claudecode.eclipse,
 com.anthropic.claudecode.eclipse.mcp,
 com.anthropic.claudecode.eclipse.server
